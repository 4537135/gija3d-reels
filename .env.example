# Copy to .env and fill in. Never commit .env.

# Claude (script + animation writer) - https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-fable-5-2        # default. Cheaper: claude-opus-5-5 or claude-sonnet-5-5
# CLAUDE_EFFORT=high                    # low | medium | high | xhigh | max

# Fish Audio (voice + transcription) - https://fish.audio/app/api-keys
FISH_API_KEY=
# FISH_VOICE_ID=                        # defaults to voice.txt
# FISH_MODEL=s2.1-pro-free

# Discord bot - https://discord.com/developers/applications  (Bot -> Reset Token)
DISCORD_TOKEN=
# DISCORD_CHANNEL_ID=1571986287232286801   # #reels-inbox
# POLL_SECONDS=20
# DISCORD_MAX_MB=10                     # raise to 25/50/100 if your server is boosted

# Instagram often blocks logged-out downloads. Use ONE of these if IG links fail:
# YTDLP_COOKIES=C:\Users\you\cookies.txt
# YTDLP_COOKIES_FROM_BROWSER=firefox

# What the channel is about (goes into Claude's instructions)
# CHANNEL_NICHE=3D printing tips for hobbyists. Brand: GIJA3D (gija3d.lt).
