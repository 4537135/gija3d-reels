{
  "name": "gija3d-reels",
  "version": "2.0.0",
  "private": true,
  "description": "Discord bot: paste a TikTok/Instagram link, get back a rewritten faceless reel (Claude + Fish Audio).",
  "main": "bot.js",
  "scripts": {
    "start": "node --env-file=.env bot.js",
    "once": "node --env-file=.env bot.js --once",
    "postinstall": "playwright install chromium && npm run build:three",
    "build:three": "esbuild vendor/three-entry.mjs --bundle --format=iife --global-name=THREE --minify --log-level=warning --outfile=vendor/three.iife.js"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "playwright": "^1.65.1",
    "three": "^0.187.0",
    "youtube-dl-exec": "^3.1.19"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
